# ============================================
# AI 漫剧 Web 平台 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际值

# ---- 数据库 ----
DATABASE_URL="postgresql://<your-user>@127.0.0.1:15432/manjv_studio?schema=public"

# ---- Redis ----
REDIS_URL="redis://127.0.0.1:16379"
REDIS_KEY_PREFIX="manjv_studio:"

# ---- 存储 ----
# local provider 写入 UPLOAD_DIR/media；生产正式产物应使用 aliyun-oss 或 s3。
# FFmpeg/QC 仍会在 UPLOAD_DIR 下创建临时文件，任务完成后按需清理。
UPLOAD_DIR="./uploads"
PUBLIC_ASSET_BASE_URL="http://localhost:3100/assets"

# ---- FFmpeg ----
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# 默认启用成片响度归一化；如需排障可设为 false
FFMPEG_NORMALIZE_AUDIO=true

# ---- 模型模式 ----
# USE_MOCK_MODEL=true 时走 Mock；false 时走 Ark/豆包真实模型
USE_MOCK_MODEL=false

# ---- Ark / 火山引擎 ----
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
ARK_API_KEY=your_ark_api_key
ARK_TEXT_MODEL=doubao-seed-2-0-pro-260215
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# ---- 运行环境 ----
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# ---- 媒体存储（Phase 7/8）----
# Provider 选择：local（仅 dev）| s3（S3-compatible 通用）| aliyun-oss（阿里云 OSS，生产推荐）
MEDIA_STORAGE_PROVIDER=local
# 仅 s3 provider 需要以下配置（local/aliyun-oss 时忽略）
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_BUCKET=
# endpoint: MinIO/自建 S3 兼容需配置；AWS S3 可留空
MEDIA_STORAGE_ENDPOINT=
# forcePathStyle: MinIO/本地需 true；TOS/OSS/R2 通常 false（virtual host style）
MEDIA_STORAGE_FORCE_PATH_STYLE=false
# publicBaseUrl: 公网访问 base URL（可选，用于 Ark 视频服务下载签名 URL）
MEDIA_STORAGE_PUBLIC_BASE_URL=

# ---- Aliyun OSS（Phase 8，MEDIA_STORAGE_PROVIDER=aliyun-oss 时必填）----
# Bucket: manjv-studio（私有），地域：华东1（杭州）
OSS_BUCKET=manjv-studio
OSS_REGION=oss-cn-hangzhou
# 公网 endpoint：本地 Mac / 外部服务器 / 浏览器与 Ark 的签名 URL 必用
OSS_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 内网 endpoint：仅当后端部署在阿里云杭州同地域 ECS/VPC 时填写
OSS_INTERNAL_ENDPOINT=
# 是否使用内网上传 Client（需明确确认部署在杭州同地域，本地开发必须 false）
OSS_USE_INTERNAL_ENDPOINT=false
# RAM 用户凭证（服务端专用，禁止使用 NEXT_PUBLIC_ 前缀，禁止提交真实值）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 私有 GET 签名 URL 有效期（秒，合理范围 300~604800）
OSS_SIGNED_URL_EXPIRES_SECONDS=3600
