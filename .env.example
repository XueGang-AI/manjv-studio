# ============================================
# AI 漫剧 Web 平台 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际值

# ---- 数据库 ----
DATABASE_URL="postgresql://<your-user>@localhost:5432/manjv_studio?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Agnes 文本模型 ----
AGNES_TEXT_API_BASE_URL=""
AGNES_TEXT_API_KEY=""
AGNES_TEXT_MODEL="Agnes-2.0-Flash"

# ---- Agnes 图片模型 ----
AGNES_IMAGE_API_BASE_URL=""
AGNES_IMAGE_API_KEY=""
AGNES_IMAGE_MODEL="Agnes-Image-2.0-Flash"

# ---- Agnes 视频模型 ----
AGNES_VIDEO_API_BASE_URL=""
AGNES_VIDEO_API_KEY=""
AGNES_VIDEO_MODEL="Agnes-Video-2.0"

# ---- 存储 ----
UPLOAD_DIR="./uploads"
PUBLIC_ASSET_BASE_URL="http://localhost:3000/assets"

# ---- FFmpeg ----
FFMPEG_PATH="ffmpeg"

# ---- 模型 Provider 选择 ----
# USE_MOCK_MODEL=true 时永远走 Mock
# 项目级 provider 以 projects.model_provider 为准
# agnes = 免费模式 | ark = 付费模式
USE_MOCK_MODEL=false
MODEL_PROVIDER=agnes

# ---- Ark / 火山引擎（付费模式） ----
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_ark_api_key
ARK_TEXT_MODEL=doubao-seed-character-251128
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# ---- 运行环境 ----
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
