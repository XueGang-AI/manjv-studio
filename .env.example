# ============================================
# AI 漫剧 Web 平台 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际值

# ---- 数据库 ----
DATABASE_URL="postgresql://<your-user>@localhost:5432/manjv_studio?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Agnes 文本模型 ----
AGNES_TEXT_API_BASE_URL=""
AGNES_TEXT_API_KEY=""
AGNES_TEXT_MODEL="Agnes-2.0-Flash"

# ---- Agnes 图片模型 ----
AGNES_IMAGE_API_BASE_URL=""
AGNES_IMAGE_API_KEY=""
AGNES_IMAGE_MODEL="Agnes-Image-2.0-Flash"

# ---- Agnes 视频模型 ----
AGNES_VIDEO_API_BASE_URL=""
AGNES_VIDEO_API_KEY=""
AGNES_VIDEO_MODEL="Agnes-Video-2.0"

# ---- 存储 ----
UPLOAD_DIR="./uploads"
PUBLIC_ASSET_BASE_URL="http://localhost:3000/assets"

# ---- FFmpeg ----
FFMPEG_PATH="ffmpeg"

# ---- 模型 Provider 选择 ----
# USE_MOCK_MODEL=true 时永远走 Mock
# 项目级 provider 以 projects.model_provider 为准
# agnes = 免费模式 | ark = 付费模式
USE_MOCK_MODEL=false
MODEL_PROVIDER=agnes

# ---- Ark / 火山引擎（付费模式） ----
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_ark_api_key
ARK_TEXT_MODEL=doubao-seed-character-251128
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# ---- 运行环境 ----
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- 媒体存储（Phase 7）----
# local: 仅开发环境，文件存 UPLOAD_DIR/media，通过 /api/media 静态服务
# s3: 生产环境，S3-compatible（AWS S3 / MinIO / 阿里云 OSS / 火山引擎 TOS / Cloudflare R2）
MEDIA_STORAGE_PROVIDER=local
# 仅 s3 provider 需要以下配置（local 时忽略）
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_BUCKET=
# endpoint: MinIO/自建 S3 兼容需配置；AWS S3 可留空
MEDIA_STORAGE_ENDPOINT=
# forcePathStyle: MinIO/本地需 true；TOS/OSS/R2 通常 false（virtual host style）
MEDIA_STORAGE_FORCE_PATH_STYLE=false
# publicBaseUrl: 公网访问 base URL（可选，用于 Ark 视频服务下载签名 URL）
MEDIA_STORAGE_PUBLIC_BASE_URL=
