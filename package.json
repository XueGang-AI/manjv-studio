{
  "name": "manjv-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:all": "bash scripts/dev-all.sh",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "npx tsx src/server/workers/task.worker.ts",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts && npx tsx scripts/seed_templates.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "data:integrity": "npx tsx scripts/repair-data-integrity.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx tsx scripts/e2e-mock-flow.ts",
    "test:e2e:real": "npx tsx scripts/e2e-real-90s-blue-jersey.ts",
    "test:e2e:real:30s": "npx tsx scripts/e2e-real-30s-umbrella-night.ts",
    "test:e2e:real:minimal": "npx tsx scripts/e2e-real-minimal.ts",
    "test:e2e:real:blue:resume": "npx tsx scripts/resume-real-90s-blue-jersey.ts",
    "probe:ark:text": "npx tsx scripts/probes/probe-ark-text.ts",
    "probe:ark:image": "npx tsx scripts/probes/probe-ark-image.ts",
    "probe:ark:video": "npx tsx scripts/probes/probe-ark-video.ts",
    "probe:ark:video:last-frame": "npx tsx scripts/probes/probe-ark-last-frame.ts",
    "probe:ark:video:poll": "npx tsx scripts/probes/poll-ark-video-task.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ali-oss": "^6.23.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "esbuild": "0.28.1",
    "postcss": "8.5.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
