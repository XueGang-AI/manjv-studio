# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development
.env.production
.env.*.local

# uploads
/uploads/

# scripts output (parsed files)
/scripts/output/

# screenshots (local UI snapshots, not source)
/screenshots/

# local static test assets (experimental preview assets)
/public/

# local Claude Code workspace config
/.claude/

# logs
*.log

# local agent working memory
/agent_memory/
/agents/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
